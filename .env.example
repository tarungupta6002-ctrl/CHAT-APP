# Database (Turso Cloud SQLite)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
PORT=3000

# VideoSDK Credentials
VIDEOSDK_API_KEY=
VIDEOSDK_SECRET_KEY=

# Security & JWT
JWT_SECRET=

# Google Authentication (Google Identity Services)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Service (SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="ChatHub Security" <noreply@chathub.com>

# AI Assistant (Google Gemini / OpenAI / Mock)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
AI_DAILY_QUOTA=25
AI_REQUEST_TIMEOUT_MS=25000
